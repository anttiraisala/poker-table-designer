%!PS-Adobe-3.0 EPSF-3.0
%%LanguageLevel: 2
%%BoundingBox: -10000 -10000 10000 10000
%%EndComments
%%BeginSetup
%%EndSetup
%%BeginProlog
% Short operator names used by the path below (standard PostScript, one line each).
50 dict begin
/q { gsave } bind def
/Q { grestore } bind def
/w { setlinewidth } bind def
/J { setlinecap } bind def
/j { setlinejoin } bind def
/M { setmiterlimit } bind def
/d { setdash } bind def
/g { setgray } bind def
/m { moveto } bind def
/l { lineto } bind def
/c { curveto } bind def
/h { closepath } bind def
/S { stroke } bind def
/n { newpath } bind def
%%EndProlog
%%Page: 1 1
%%BeginPageSetup
%%PageBoundingBox: -10000 -10000 10000 10000
%%EndPageSetup
% Cut lines only: thin outlines, no fills, no groups, no clipping.
q q
0 g
1.41732 w
0 J
0 j
[] 0.0 d
4 M q
141.732 141.732 m
141.732 63.456 78.277 0 0 0 c
% CutStudio skips the last line unless one more moveto follows it:
0 0 m
S Q
Q Q
showpage
%%Trailer
end
%%EOF
